# ============================================================
# Large binary files - store in cloud storage (HuggingFace/GDrive)
# ============================================================

# Model checkpoints & weights
*.pt
*.pth
*.ckpt
*.safetensors
backend/data/checkpoints/
backend/models/weights/

# Satellite imagery & GeoTIFF files (large binary)
*.tif
*.tiff
*.geotiff

# PDF reports (generated at runtime)
*.pdf
backend/data/reports/

# Large data directories
backend/data/
data/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/
.env

# Environment variables
.env
.env.local
.env.*.local

# pytest
.pytest_cache/
.coverage
htmlcov/
*.log

# Logs
logs/
*.log

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Node (frontend)
node_modules/
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local

# OS files
.DS_Store
Thumbs.db

# Data (large files / sensitive)
data/*.csv
data/*.db
data/*.sqlite
data/*.json
*.pkl
*.pickle

# Scratch / temp
scratch/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# API Keys / secrets
*.pem
*.key
secrets.json
config/secrets*
